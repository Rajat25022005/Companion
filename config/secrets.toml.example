# Companion Secrets Vault (Example Template)
# Copy this file to config/secrets.toml and fill in your confidential API keys.
# NEVER commit config/secrets.toml to source control.

[api_keys]
gemini_api_key = ""
openai_api_key = ""
github_token = ""
nvidia_api_key = ""

[database]
postgres_url = "postgresql://companion:companion_dev@localhost:5432/companion"

[models]
default_model = "gemini-3.7-flash"

[custom]
# Add arbitrary service keys here:
# internal_service_token = "secret_value"
